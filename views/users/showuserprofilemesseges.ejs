<% layout("/layouts/boilerplate.ejs") %>

<div class="container mt-4 mb-5">
  <div class="row justify-content-center">
    <div class="col-12 col-lg-8">
      
      <!-- OLX Messenger Container -->
      <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white">
        
        <!-- Header Bar -->
        <div class="card-header bg-white border-bottom p-3">
          <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            
            <!-- Left: Back Button + User Info -->
            <div class="d-flex align-items-center gap-3">
              <a href="/profile/messages" class="text-dark me-1" title="Back to Messages"><i class="fa-solid fa-arrow-left fs-5"></i></a>
              
              <% if(listing && listing.image) { %>
                <img src="<%= listing.image.url %>" class="rounded-3 object-fit-cover border" style="width: 48px; height: 48px;" alt="listing">
              <% } %>
              
              <div>
                <% if(otherUser) { %>
                  <h6 class="fw-bold mb-0 text-dark">
                    <i class="fa-solid fa-user text-danger me-1"></i><%= otherUser.username %>
                  </h6>
                  <small class="text-muted d-block">
                    <i class="fa-solid fa-phone text-success me-1"></i>Contact: <strong><%= otherUser.contact || 'Not Provided' %></strong>
                  </small>
                <% } else { %>
                  <h6 class="fw-bold mb-0 text-muted">
                    <i class="fa-solid fa-user-slash text-secondary me-1"></i>User Unavailable
                  </h6>
                  <small class="text-danger fw-semibold d-block">Account Deleted</small>
                <% } %>
              </div>
            </div>

            <!-- Right: Account Status Indicator -->
            <div class="text-end border-start ps-3 d-none d-sm-block">
              <% if(!otherUser) { %>
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">User Unavailable</span>
              <% } else if(!listing) { %>
                <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">Listing Removed</span>
              <% } else { %>
                <small class="text-muted d-block">Your Account Contact:</small>
                <span class="badge bg-light text-dark border px-2 py-1">
                  <i class="fa-solid fa-id-badge text-danger me-1"></i><%= crrUser.contact || 'No Contact Saved' %>
                </span>
              <% } %>
            </div>

          </div>

          <!-- Sub Header: Listing Info or Unavailable Alerts -->
          <div class="mt-2 pt-2 border-top d-flex justify-content-between align-items-center flex-wrap gap-1">
            <% if(listing) { %>
              <small class="text-muted">Item: <a href="/listings/<%= listing._id %>" class="fw-bold text-danger text-decoration-none"><%= listing.title %></a></small>
              <span class="fw-bold text-danger small">&#8360 <%= listing.price.toLocaleString("en-PK") %></span>
            <% } else { %>
              <span class="text-danger small fw-semibold"><i class="fa-solid fa-circle-info me-1"></i>This listing is not available right now.</span>
            <% } %>
          </div>
        </div>

        <!-- Chat Body -->
        <div class="card-body p-3 p-md-4 bg-light overflow-y-auto" id="chatScrollBox" style="height: 420px;">
          <% for(let msg of conversation) { %>
            <% const isMe = msg.sender && msg.sender._id.equals(crrUser._id); %>
            <div class="d-flex flex-column <%= isMe ? 'align-items-end' : 'align-items-start' %> mb-3">
              
              <div class="small text-muted mb-1 px-1">
                <strong><%= isMe ? 'You (' + crrUser.username + ')' : (msg.sender ? msg.sender.username : 'Unavailable User') %></strong>
                <% if(msg.senderContact) { %>
                  <span class="ms-1 text-secondary small">(<i class="fa-solid fa-phone me-1"></i><%= msg.senderContact %>)</span>
                <% } %>
              </div>

              <div class="p-3 shadow-sm rounded-4 <%= isMe ? 'bg-danger text-white rounded-bottom-end-0' : 'bg-white text-dark border rounded-bottom-start-0' %>" style="max-width: 80%;">
                <p class="mb-0 text-break fs-6"><%= msg.message %></p>
              </div>

              <small class="text-muted mt-1 px-1" style="font-size: 0.72rem;">
                <%= msg.createdAt ? msg.createdAt.toString().split(" ").slice(4, 5).join("") + " - " + msg.createdAt.toString().split(" ").slice(0, 4).join(" ") : '' %>
              </small>
            </div>
          <% } %>
        </div>

        <!-- Chat Reply Input Footer Form -->
        <div class="card-footer bg-white border-top p-3">
          <% if(!otherUser) { %>
            <div class="alert alert-secondary text-center mb-0 py-2 small fw-semibold">
              <i class="fa-solid fa-ban me-1 text-danger"></i> You cannot send messages because this user account has been deleted.
            </div>
          <% } else if(!listing) { %>
            <div class="alert alert-warning text-center mb-0 py-2 small fw-semibold">
              <i class="fa-solid fa-circle-exclamation me-1 text-warning"></i> This listing is not available right now. You cannot send new messages for this listing.
            </div>
          <% } else { %>
            <form action="/profile/messages/<%= targetMessageId %>/reply" method="POST" class="needs-validation" novalidate>
              <div class="input-group">
                <input type="text" name="message" class="form-control rounded-start-pill border-end-0 px-3 py-2" placeholder="Type a message to <%= otherUser.username %>..." required autocomplete="off">
                <button class="btn btn-danger rounded-end-pill px-4 fw-semibold" type="submit">
                  <i class="fa-solid fa-paper-plane me-1"></i> Send
                </button>
              </div>
            </form>
          <% } %>
        </div>

      </div>

    </div>
  </div>
</div>

<script>
  const chatBox = document.getElementById("chatScrollBox");
  if(chatBox) {
    chatBox.scrollTop = chatBox.scrollHeight;
  }
</script>