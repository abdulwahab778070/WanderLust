<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center my-5">
  <div class="col-lg-8 col-md-10">
    
    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4 pb-3 border-bottom">
      <div class="mb-3 mb-md-0">
        <h2 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
          <div class="bg-danger bg-opacity-10 text-danger p-2 rounded-3 d-inline-flex align-items-center justify-content-center">
            <i class="fa-solid fa-bullhorn fs-5"></i>
          </div>
          WanderLust Notices
        </h2>
        <p class="text-muted mb-0 small mt-1">Direct announcements and official updates from the WanderLust team.</p>
      </div>
      
      <div class="d-flex align-items-center flex-wrap gap-2">
        <div class="badge bg-light text-dark border border-secondary border-opacity-25 px-3 py-2 rounded-pill shadow-sm fw-medium">
          Total: <%= notifications.length %>
        </div>
        
        <% if (notifications && notifications.length > 0) { %>
          <form action="/notifications/delete-all" method="POST" class="d-inline m-0 p-0">
            <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1.5 fw-semibold shadow-sm d-flex align-items-center gap-1">
              <i class="fa-solid fa-trash-can"></i> Delete All
            </button>
          </form>
        <% } %>
      </div>
    </div>

    <!-- Notifications List -->
    <% if (notifications && notifications.length > 0) { %>
      <div class="d-flex flex-column gap-3">
        <% notifications.forEach(notif => { %>
          <div class="card border border-light shadow-sm rounded-4 bg-white position-relative overflow-hidden transition-hover">
            <div class="position-absolute top-0 start-0 bg-danger h-100" style="width: 4px;"></div>
            
            <div class="card-body p-4">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <div class="d-flex align-items-center gap-2">
                  <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-1.5 rounded-pill fw-bold" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                    <i class="fa-solid fa-shield-halved me-1"></i> OFFICIAL NOTICE
                  </span>
                </div>
                
                <div class="d-flex align-items-center gap-3">
                  <small class="text-muted fw-medium" style="font-size: 0.8rem;">
                    <i class="fa-regular fa-calendar me-1"></i>
                    <%= new Date(notif.createdAt).toLocaleDateString("en-US", { month: 'short', day: 'numeric', year: 'numeric' }) %> 
                    <span class="mx-1">•</span>
                    <%= new Date(notif.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
                  </small>
                  <form action="/notifications/<%= notif._id %>?_method=DELETE" method="POST" class="d-inline m-0 p-0">
                    <button type="submit" class="btn btn-sm btn-light text-secondary rounded-circle p-2 d-flex align-items-center justify-content-center shadow-none hover-danger" title="Delete notice" style="width: 32px; height: 32px;">
                      <i class="fa-solid fa-xmark"></i>
                    </button>
                  </form>
                </div>
              </div>

              <div class="mt-3 ps-1 pe-md-4">
                <p class="text-dark fs-6 lh-lg mb-0 text-break fw-medium">
                  <%= notif.message %>
                </p>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <!-- Empty State -->
      <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-light">
        <div class="py-5">
          <div class="bg-white rounded-circle d-inline-flex align-items-center justify-content-center mb-4 shadow-sm" style="width: 80px; height: 80px;">
            <i class="fa-solid fa-bell-slash fs-2 text-muted opacity-50"></i>
          </div>
          <h4 class="fw-bold text-dark mb-2">No Notices Found</h4>
          <p class="text-muted mb-0">You're all caught up! You have not received any official announcements from WanderLust yet.</p>
        </div>
      </div>
    <% } %>

  </div>
</div>

<style>
  .transition-hover {
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .transition-hover:hover {
    transform: translateY(-2px);
    box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
  }
  .hover-danger:hover {
    background-color: #dc3545 !important;
    color: white !important;
  }
  .cursor-pointer {
    cursor: pointer;
  }
</style>