<% layout("/layouts/boilerplate.ejs") %>

<div class="row mt-4 mb-5">
  <div class="col-12 col-md-8 col-lg-7 mx-auto">
    
    <div class="text-center mb-4">
      <div class="auth-icon-box mb-2">
        <i class="fa-solid fa-gear text-danger display-5"></i>
      </div>
      <h3 class="fw-bold mb-1">Account Settings</h3>
      <p class="text-muted small">Manage your profile information, security preferences, and account data</p>
    </div>

    <!-- Settings Navigation Pills -->
    <ul class="nav nav-pills mb-4 bg-white p-2 rounded-4 shadow-sm border" id="settingsTabs" role="tablist">
      <li class="nav-item flex-fill text-center" role="presentation">
        <button class="nav-link active rounded-pill fw-semibold w-100 py-2.5" id="profile-tab" data-bs-toggle="pill" data-bs-target="#profile-section" type="button" role="tab" aria-controls="profile-section" aria-selected="true">
          <i class="fa-solid fa-user-pen me-2"></i>Profile Info
        </button>
      </li>
      <li class="nav-item flex-fill text-center" role="presentation">
        <button class="nav-link rounded-pill fw-semibold w-100 py-2.5" id="security-tab" data-bs-toggle="pill" data-bs-target="#security-section" type="button" role="tab" aria-controls="security-section" aria-selected="false">
          <i class="fa-solid fa-shield-halved me-2"></i>Security
        </button>
      </li>
      <li class="nav-item flex-fill text-center" role="presentation">
        <button class="nav-link rounded-pill fw-semibold w-100 py-2.5" id="danger-tab" data-bs-toggle="pill" data-bs-target="#danger-section" type="button" role="tab" aria-controls="danger-section" aria-selected="false">
          <i class="fa-solid fa-user-xmark me-2"></i>Account Deletion
        </button>
      </li>
    </ul>

    <!-- Tab Content Container -->
    <div class="tab-content" id="settingsTabsContent">
      
      <!-- 1. Profile Info Tab -->
      <div class="tab-pane fade show active" id="profile-section" role="tabpanel" aria-labelledby="profile-tab">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white mb-4">
          <h5 class="fw-bold mb-3 text-dark"><i class="fa-solid fa-address-card text-danger me-2"></i>Personal Information</h5>
          
          <form method="POST" action="/profile/settings?_method=PUT" novalidate class="needs-validation">
            
            <div class="mb-3">
              <label for="username" class="form-label fw-semibold">Username <small class="text-muted">(Cannot be changed)</small></label>
              <div class="input-group">
                <span class="input-group-text bg-light border-end-0 rounded-start-3"><i class="fa-solid fa-user text-muted"></i></span>
                <input id="username" name="username" type="text" class="form-control border-start-0 rounded-end-3 ps-1 bg-light text-muted" value="<%= crrUser.username %>" readonly disabled>
              </div>
            </div>

            <div class="mb-3">
              <label for="email" class="form-label fw-semibold">Email Address <small class="text-muted">(Cannot be changed)</small></label>
              <div class="input-group">
                <span class="input-group-text bg-light border-end-0 rounded-start-3"><i class="fa-solid fa-envelope text-muted"></i></span>
                <input id="email" name="email" type="email" class="form-control border-start-0 rounded-end-3 ps-1 bg-light text-muted" value="<%= crrUser.email %>" readonly disabled>
              </div>
            </div>

            <div class="mb-4">
              <label for="contact" class="form-label fw-semibold">Contact / WhatsApp Number</label>
              <div class="input-group">
                <span class="input-group-text bg-light border-end-0 rounded-start-3"><i class="fa-solid fa-phone text-muted"></i></span>
                <input id="contact" name="contact" placeholder="e.g. 03122711829" type="tel" class="form-control border-start-0 rounded-end-3 ps-1" value="<%= crrUser.contact || '' %>" required>
                <div class="invalid-feedback">Please enter a valid phone or WhatsApp number.</div>
              </div>
            </div>

            <button class="btn btn-dark w-100 py-2.5 rounded-3 fw-semibold" onclick="localStorage.setItem('activeSettingsTag', '#profile-section')">
              <i class="fa-solid fa-floppy-disk me-1"></i> Save Changes
            </button>
          </form>
        </div>
      </div>

      <!-- 2. Security & Password Tab -->
      <div class="tab-pane fade" id="security-section" role="tabpanel" aria-labelledby="security-tab">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white mb-4">
          <h5 class="fw-bold mb-3 text-dark"><i class="fa-solid fa-key text-danger me-2"></i>Change Password</h5>
          
          <form method="POST" action="/profile/change-password?_method=PUT" novalidate class="needs-validation" onsubmit="return validatePasswordMatch()">
            
            <!-- Current Password -->
            <div class="mb-3">
              <label for="currentPassword" class="form-label fw-semibold">Current Password</label>
              <div class="input-group">
                <span class="input-group-text bg-light border-end-0 rounded-start-3"><i class="fa-solid fa-lock text-muted"></i></span>
                <input id="currentPassword" name="currentPassword" placeholder="Enter current password" type="password" class="form-control border-start-0 border-end-0 rounded-0 ps-1" required>
                <button class="btn btn-outline-secondary border bg-light rounded-end-3 text-muted px-3" type="button" onclick="togglePasswordVisibility('currentPassword', 'toggleCurrentIcon')">
                  <i class="fa-solid fa-eye" id="toggleCurrentIcon"></i>
                </button>
                <div class="invalid-feedback">Please enter your current password.</div>
              </div>
            </div>

            <!-- New Password -->
            <div class="mb-3">
              <label for="newPassword" class="form-label fw-semibold">New Password</label>
              <div class="input-group">
                <span class="input-group-text bg-light border-end-0 rounded-start-3"><i class="fa-solid fa-key text-muted"></i></span>
                <input id="newPassword" name="newPassword" placeholder="Enter new password" type="password" class="form-control border-start-0 border-end-0 rounded-0 ps-1" required>
                <button class="btn btn-outline-secondary border bg-light rounded-end-3 text-muted px-3" type="button" onclick="togglePasswordVisibility('newPassword', 'toggleNewIcon')">
                  <i class="fa-solid fa-eye" id="toggleNewIcon"></i>
                </button>
                <div class="invalid-feedback">Please enter a new password.</div>
              </div>
            </div>

            <!-- Confirm New Password -->
            <div class="mb-4">
              <label for="confirmPassword" class="form-label fw-semibold">Confirm New Password</label>
              <div class="input-group">
                <span class="input-group-text bg-light border-end-0 rounded-start-3"><i class="fa-solid fa-check-double text-muted"></i></span>
                <input id="confirmPassword" name="confirmPassword" placeholder="Confirm new password" type="password" class="form-control border-start-0 border-end-0 rounded-0 ps-1" required>
                <button class="btn btn-outline-secondary border bg-light rounded-end-3 text-muted px-3" type="button" onclick="togglePasswordVisibility('confirmPassword', 'toggleConfirmIcon')">
                  <i class="fa-solid fa-eye" id="toggleConfirmIcon"></i>
                </button>
                <div class="invalid-feedback">Please confirm your new password.</div>
              </div>
              <div id="passwordError" class="text-danger small mt-1 d-none"><i class="fa-solid fa-circle-exclamation me-1"></i>New passwords do not match!</div>
            </div>

            <button class="btn btn-danger w-100 py-2.5 rounded-3 fw-semibold">
              <i class="fa-solid fa-shield-halved me-1"></i> Update Password
            </button>
          </form>
        </div>
      </div>

      <!-- 3. Account Deletion Tab -->
      <div class="tab-pane fade" id="danger-section" role="tabpanel" aria-labelledby="danger-tab">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white mb-4">
          <h5 class="fw-bold mb-3 text-danger"><i class="fa-solid fa-triangle-exclamation me-2"></i>Account Deletion</h5>
          <p class="text-muted small mb-4">Once you delete your WanderLust account, all your created listings and active chat threads will be permanently removed from our database.</p>
          
          <div class="alert alert-danger rounded-3 small mb-4">
            <strong>Warning:</strong> This action is permanent and cannot be undone. All your personal data, properties, and message records will be wiped out.
          </div>

          <button type="button" class="btn btn-outline-danger rounded-3 w-100 fw-semibold py-2.5" data-bs-toggle="modal" data-bs-target="#deleteAccountModal">
            <i class="fa-solid fa-user-xmark me-1"></i> Permanently Delete My Account
          </button>
        </div>
      </div>

    </div>

  </div>
</div>

<!-- Account Deletion Warning Popup Modal with Password Confirmation -->
<div class="modal fade" id="deleteAccountModal" tabindex="-1" aria-labelledby="deleteAccountModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg rounded-4">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-header-title fw-bold text-danger" id="deleteAccountModalLabel">
          <i class="fa-solid fa-triangle-exclamation me-2"></i>Permanently Delete Account?
        </h5>
        <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <form action="/profile/delete-account?_method=DELETE" method="POST" onsubmit="localStorage.setItem('activeSettingsTag', '#danger-section')">
        <div class="modal-body py-3">
          <div class="alert alert-danger rounded-3 small mb-3">
            <strong>Warning:</strong> Deleting your account will permanently delete all your listings and chat history from our servers!
          </div>
          <p class="text-secondary small mb-3">Please enter your current password to confirm account deletion.</p>
          
          <!-- Password Input Field -->
          <div class="mb-3">
            <label for="deletePassword" class="form-label small fw-semibold text-danger">Current Password</label>
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0 rounded-start-3"><i class="fa-solid fa-lock text-muted"></i></span>
              <input id="deletePassword" name="currentPassword" placeholder="Enter your password" type="password" class="form-control border-start-0 border-end-0 rounded-0 ps-1" required>
              <button class="btn btn-outline-secondary border bg-light rounded-end-3 text-muted px-3" type="button" onclick="togglePasswordVisibility('deletePassword', 'toggleDeleteIcon')">
                <i class="fa-solid fa-eye" id="toggleDeleteIcon"></i>
              </button>
            </div>
          </div>
        </div>

        <div class="modal-footer border-0 pt-0">
          <button type="button" class="btn btn-outline-secondary rounded-pill btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-danger rounded-pill px-4 fw-semibold btn-sm">Yes, Delete Account</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const flashError = "<%= (typeof error !== 'undefined' && error.length > 0) ? error : '' %>";
    
    let activeTab = localStorage.getItem("activeSettingsTag") || "#profile-section";
    
    if (flashError) {
      const errLower = flashError.toLowerCase();
      if (errLower.includes("deletion") || errLower.includes("incorrect password")) {
        activeTab = "#danger-section";
        localStorage.setItem("activeSettingsTag", "#danger-section");
      } else if (errLower.includes("password")) {
        activeTab = "#security-section";
        localStorage.setItem("activeSettingsTag", "#security-section");
      }
    }

    const targetButton = document.querySelector(`[data-bs-target="${activeTab}"]`);
    if (targetButton) {
      const tab = new bootstrap.Tab(targetButton);
      tab.show();
    }

    const tabElList = document.querySelectorAll('button[data-bs-toggle="pill"]');
    tabElList.forEach(function (tabEl) {
      tabEl.addEventListener("shown.bs.tab", function (event) {
        const targetId = event.target.getAttribute("data-bs-target");
        localStorage.setItem("activeSettingsTag", targetId);
      });
    });
  });

  const passwordForm = document.querySelector('form[action*="change-password"]');
  if (passwordForm) {
    passwordForm.addEventListener("submit", function() {
      localStorage.setItem("activeSettingsTag", "#security-section");
    });
  }

  function togglePasswordVisibility(fieldId, iconId) {
    const passwordInput = document.getElementById(fieldId);
    const toggleIcon = document.getElementById(iconId);
    
    if (passwordInput.type === "password") {
      passwordInput.type = "text";
      toggleIcon.classList.remove("fa-eye");
      toggleIcon.classList.add("fa-eye-slash");
    } else {
      passwordInput.type = "password";
      toggleIcon.classList.remove("fa-eye-slash");
      toggleIcon.classList.add("fa-eye");
    }
  }

  function validatePasswordMatch() {
    const newPass = document.getElementById("newPassword").value;
    const confirmPass = document.getElementById("confirmPassword").value;
    const errorDiv = document.getElementById("passwordError");

    localStorage.setItem("activeSettingsTag", "#security-section");

    if (newPass !== confirmPass) {
      errorDiv.classList.remove("d-none");
      return false;
    }
    errorDiv.classList.add("d-none");
    return true;
  }
</script>