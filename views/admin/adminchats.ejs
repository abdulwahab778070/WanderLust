<% layout("admin/adminboilerplate.ejs") %>

<div class="container-fluid px-0">
  <!-- Top Header & Navigation -->
  <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4 gap-3">
    <div>
      <h2 class="fw-bold text-dark mb-1">Admin All Chats Inbox</h2>
      <p class="text-muted mb-0 small">Manage conversations and official notice threads with registered users.</p>
    </div>
    
    <div class="d-flex align-items-center gap-3">
      <div class="badge bg-dark fs-6 px-3 py-2 rounded-3">
        Total Threads: <%= chatsWithDetails ? chatsWithDetails.length : 0 %>
      </div>
      <% if (chatsWithDetails && chatsWithDetails.length > 0) { %>
        <form action="/admin/chats/delete-all-system" method="POST" class="d-inline" onsubmit="return confirm('WARNING: Are you sure you want to permanently delete ALL chat messages across the entire database?');">
          <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-2 fw-semibold shadow-sm d-flex align-items-center gap-1">
            <i class="fa-solid fa-trash-can"></i> Delete All Database Chats
          </button>
        </form>
      <% } %>
    </div>
  </div>

  <!-- Search Bar Section -->
  <% if (chatsWithDetails && chatsWithDetails.length > 0) { %>
    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-4">
      <div class="input-group">
        <span class="input-group-text bg-light border-0 text-muted ps-3"><i class="fa-solid fa-magnifying-glass"></i></span>
        <input type="text" id="chatSearchInput" class="form-control bg-light border-0 shadow-none" placeholder="Search user by username or email..." autocomplete="off">
      </div>
    </div>

    <!-- Chat Threads List -->
    <div class="d-flex flex-column gap-3" id="chatsListContainer">
      <% chatsWithDetails.forEach(item => { %>
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white chat-card transition-hover position-relative overflow-hidden" data-search="<%= item.user.username ? item.user.username.toLowerCase() : '' %> <%= item.user.email ? item.user.email.toLowerCase() : '' %>">
          <div class="position-absolute top-0 start-0 bg-danger h-100" style="width: 4px;"></div>
          
          <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <!-- User Profile & Info -->
            <a href="/admin/chats/user/<%= item.user._id %>" class="d-flex align-items-center gap-3 text-decoration-none flex-grow-1">
              <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center fw-bold fs-5" style="width: 50px; height: 50px; flex-shrink: 0;">
                <%= item.user.username ? item.user.username.charAt(0).toUpperCase() : 'U' %>
              </div>
              <div>
                <h5 class="fw-bold text-dark mb-0"><%= item.user.username %></h5>
                <small class="text-muted"><%= item.user.email %> | Contact: <%= item.user.contact || 'N/A' %></small>
              </div>
            </a>

            <!-- Last Message Preview & Timestamp -->
            <div class="flex-grow-1 px-md-3 text-md-start" style="max-width: 350px;">
              <% if (item.lastMessage) { %>
                <p class="text-dark small mb-0 text-truncate fw-medium">
                  <span class="text-secondary">Latest:</span> <%= item.lastMessage.message %>
                </p>
                <small class="text-muted" style="font-size: 0.75rem;">
                  <i class="fa-regular fa-clock me-1"></i>
                  <%= new Date(item.lastMessage.createdAt).toLocaleDateString("en-US", { month: 'short', day: 'numeric', year: 'numeric' }) %> at <%= new Date(item.lastMessage.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
                </small>
              <% } else { %>
                <p class="text-muted small mb-0 fst-italic">No messages exchanged yet.</p>
              <% } %>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex align-items-center gap-2">
              <span class="badge bg-light text-dark border px-2.5 py-1 rounded-pill small d-none d-sm-inline-block"><%= item.totalMessages %> Msgs</span>
              
              <a href="/admin/chats/user/<%= item.user._id %>" class="btn btn-sm btn-outline-dark rounded-pill px-3 py-1.5 fw-semibold d-flex align-items-center gap-1">
                <span>Open</span> <i class="fa-solid fa-arrow-right-long ms-1"></i>
              </a>

              <% if (item.totalMessages > 0) { %>
                <form action="/admin/chats/user/<%= item.user._id %>/delete-all" method="POST" class="d-inline" onsubmit="return confirm('Delete all chat history for <%= item.user.username %>?');">
                  <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle p-1.5 d-flex align-items-center justify-content-center" title="Delete User Chat" style="width: 32px; height: 32px;">
                    <i class="fa-solid fa-trash-can"></i>
                  </button>
                </form>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
      <div class="py-5">
        <i class="fa-regular fa-comments fs-1 text-muted opacity-50 mb-3 d-block"></i>
        <h5 class="fw-bold text-dark mb-1">No Chat Threads Found</h5>
        <p class="text-muted small mb-0">There are no user chat records available in the system yet.</p>
      </div>
    </div>
  <% } %>
</div>

<style>
  .transition-hover {
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .transition-hover:hover {
    transform: translateY(-2px);
    box-shadow: 0 .5rem 1rem rgba(0,0,0,.1) !important;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const searchInput = document.getElementById("chatSearchInput");
    const chatCards = document.querySelectorAll(".chat-card");

    if (searchInput) {
      searchInput.addEventListener("input", function (e) {
        const term = e.target.value.toLowerCase().trim();
        chatCards.forEach(card => {
          const searchData = card.getAttribute("data-search");
          if (searchData.includes(term)) {
            card.style.display = "";
          } else {
            card.style.display = "none";
          }
        });
      });
    }
  });
</script>