<% layout("admin/adminboilerplate.ejs") %>

<div class="container-fluid px-0">
  <!-- Top Header & Navigation -->
  <div class="d-flex align-items-center justify-content-between mb-4">
    <div>
      <a href="/admin/chats" class="text-decoration-none text-muted small fw-semibold mb-2 d-inline-block">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to Broadcasts
      </a>
      <h2 class="fw-bold text-dark mb-0">Admin Official Chat Thread</h2>
    </div>
  </div>

  <div class="row g-4">
    <!-- Left/Main Column: Messenger Box -->
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden d-flex flex-column" style="height: 70vh;">
        
        <!-- Chat Header -->
        <div class="p-3 bg-light border-bottom d-flex align-items-center justify-content-between gap-3">
          <div class="d-flex align-items-center gap-3">
            <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center fw-bold fs-5" style="width: 45px; height: 45px; flex-shrink: 0;">
              <%= targetUser.username ? targetUser.username.charAt(0).toUpperCase() : 'U' %>
            </div>
            <div>
              <h6 class="fw-bold text-dark mb-0"><%= targetUser.username %></h6>
              <small class="text-muted"><%= targetUser.email %> | Contact: <%= targetUser.contact || 'N/A' %></small>
            </div>
          </div>

          <!-- Delete All Chat Button -->
          <% if (messages && messages.length > 0) { %>
            <div class="flex-shrink-0">
              <form action="/admin/chats/user/<%= targetUser._id %>/delete-all" method="POST" class="d-inline m-0 p-0" onsubmit="return confirm('Are you sure you want to permanently delete all messages for this user from the database?');">
                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1.5 fw-semibold shadow-sm d-flex align-items-center gap-1">
                  <i class="fa-solid fa-trash-can"></i> Delete All Chat
                </button>
              </form>
            </div>
          <% } %>
        </div>

        <!-- Chat Messages Body -->
        <div class="card-body p-4 overflow-auto flex-grow-1 bg-light bg-opacity-25 d-flex flex-column gap-3">
          <% if (messages && messages.length > 0) { %>
            <div class="d-flex flex-column gap-3">
              <% messages.forEach(msg => { %>
                <% const isDeletedByUser = msg.deletedBy && msg.deletedBy.some(id => id.equals(targetUser._id)); %>
                <div class="d-flex flex-column align-items-end">
                  <div class="d-flex align-items-center gap-2" style="max-width: 75%;">
                    <!-- Individual Delete Button -->
                    <form action="/admin/chats/user/<%= targetUser._id %>/message/<%= msg._id %>?_method=DELETE" method="POST" class="d-inline m-0 p-0" onsubmit="return confirm('Permanently delete this message from the database?');">
                      <button type="submit" class="btn btn-sm btn-light text-danger rounded-circle p-2 d-flex align-items-center justify-content-center shadow-none hover-danger border" title="Delete permanently" style="width: 30px; height: 30px;">
                        <i class="fa-solid fa-xmark"></i>
                      </button>
                    </form>

                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-dark text-white flex-grow-1 <%= isDeletedByUser ? 'opacity-50' : '' %>">
                      <div class="d-flex align-items-center justify-content-between gap-3 mb-1">
                        <span class="badge bg-danger text-white px-2 py-0.5 rounded-pill" style="font-size: 0.65rem;">
                          <i class="fa-solid fa-shield-halved me-1"></i>Admin Official Notice
                        </span>
                        <small class="text-white-50" style="font-size: 0.7rem;">
                          <%= new Date(msg.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
                        </small>
                      </div>
                      <p class="mb-0 fs-6 lh-sm"><%= msg.message %></p>
                    </div>
                  </div>
                  
                  <div class="mt-1 me-1 d-flex align-items-center gap-2">
                    <% if (isDeletedByUser) { %>
                      <span class="text-secondary small fw-semibold" style="font-size: 0.8rem;">
                        <i class="fa-solid fa-trash-can me-1"></i>Deleted by user
                      </span>
                    <% } else { %>
                      <% if (msg.isSeen) { %>
                        <span class="text-success small" style="font-size: 0.7rem;"><i class="fa-solid fa-check-double me-1"></i>Seen by User</span>
                      <% } else { %>
                        <span class="text-muted small" style="font-size: 0.7rem;"><i class="fa-solid fa-check me-1"></i>Unread</span>
                      <% } %>
                    <% } %>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <div class="text-center py-5 my-auto text-muted">
              <i class="fa-regular fa-comments fs-1 mb-2 d-block opacity-50"></i>
              <p class="mb-0">No official messages sent to this user yet. Start the conversation below.</p>
            </div>
          <% } %>
        </div>

        <!-- Chat Input Form -->
        <div class="p-3 bg-white border-top">
          <form action="/admin/chats/user/<%= targetUser._id %>" method="POST" class="d-flex gap-2">
            <input type="text" name="messageText" class="form-control bg-light border-0 shadow-none py-2.5 px-3 rounded-3" placeholder="Type an official notice for <%= targetUser.username %>..." required autocomplete="off">
            <button type="submit" class="btn btn-dark rounded-3 px-4 fw-semibold shadow-sm d-flex align-items-center gap-2">
              <i class="fa-solid fa-paper-plane"></i> Send
            </button>
          </form>
        </div>

      </div>
    </div>

    <!-- Right Column: Quick User Info -->
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <h5 class="fw-bold text-dark mb-3 pb-2 border-bottom">User Profile Details</h5>
        <div class="mb-3">
          <small class="text-muted d-block text-uppercase fw-semibold" style="font-size: 0.75rem;">Username</small>
          <span class="text-dark fw-bold"><%= targetUser.username %></span>
        </div>
        <div class="mb-3">
          <small class="text-muted d-block text-uppercase fw-semibold" style="font-size: 0.75rem;">Email Address</small>
          <span class="text-dark fw-medium"><%= targetUser.email %></span>
        </div>
        <div class="mb-3">
          <small class="text-muted d-block text-uppercase fw-semibold" style="font-size: 0.75rem;">Contact Number</small>
          <span class="text-dark fw-medium"><%= targetUser.contact || 'Not Provided' %></span>
        </div>
        <div class="mb-3">
          <small class="text-muted d-block text-uppercase fw-semibold" style="font-size: 0.75rem;">Account ID</small>
          <span class="text-dark font-monospace small"><%= targetUser._id %></span>
        </div>
        <a href="/admin/users/<%= targetUser._id %>" class="btn btn-outline-dark w-100 rounded-3 fw-semibold shadow-sm mt-2">
          <i class="fa-solid fa-users-gear me-2"></i>Manage User in Panel
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  .hover-danger:hover {
    background-color: #dc3545 !important;
    color: white !important;
  }
</style>