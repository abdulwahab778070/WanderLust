<% layout("admin/adminboilerplate.ejs") %>

<div class="container-fluid px-0">
  <!-- Top Header & Navigation -->
  <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4 gap-3">
    <div>
      <a href="/admin/users" class="text-decoration-none text-muted small fw-semibold mb-2 d-inline-block">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to All Users
      </a>
      <h2 class="fw-bold text-dark mb-0">User Profile Details</h2>
    </div>
    
    <div class="d-flex align-items-center gap-2 flex-wrap">
      <!-- Status Actions based on current status -->
      <% if (targetUser.status === 'active') { %>
        <form action="/admin/users/<%= targetUser._id %>/status?_method=PATCH" method="POST" class="d-inline">
          <input type="hidden" name="status" value="suspended">
          <button type="submit" class="btn btn-outline-warning btn-sm rounded-pill px-3 py-1.5 fw-semibold shadow-sm" onclick="return confirm('Suspend this user account? They will not be able to log in.');">
            <i class="fa-solid fa-ban me-1"></i> Suspend Account
          </button>
        </form>
        <form action="/admin/users/<%= targetUser._id %>/status?_method=PATCH" method="POST" class="d-inline">
          <input type="hidden" name="status" value="deactivated">
          <button type="submit" class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-1.5 fw-semibold shadow-sm" onclick="return confirm('Deactivate this user account?');">
            <i class="fa-solid fa-user-slash me-1"></i> Deactivate Account
          </button>
        </form>
      <% } else if (targetUser.status === 'suspended') { %>
        <form action="/admin/users/<%= targetUser._id %>/status?_method=PATCH" method="POST" class="d-inline">
          <input type="hidden" name="status" value="active">
          <button type="submit" class="btn btn-outline-success btn-sm rounded-pill px-3 py-1.5 fw-semibold shadow-sm">
            <i class="fa-solid fa-check me-1"></i> Unsuspend Account
          </button>
        </form>
      <% } else if (targetUser.status === 'deactivated') { %>
        <form action="/admin/users/<%= targetUser._id %>/status?_method=PATCH" method="POST" class="d-inline">
          <input type="hidden" name="status" value="active">
          <button type="submit" class="btn btn-outline-success btn-sm rounded-pill px-3 py-1.5 fw-semibold shadow-sm">
            <i class="fa-solid fa-power-off me-1"></i> Activate Account
          </button>
        </form>
      <% } %>

      <!-- Permanent Delete Button -->
      <form action="/admin/users/<%= targetUser._id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to permanently delete this user and all their listings?');">
        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1.5 fw-semibold shadow-sm">
          <i class="fa-solid fa-trash-can me-1"></i> Delete User Account
        </button>
      </form>
    </div>
  </div>

  <div class="row g-4">
    <!-- User Info Card -->
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <div class="text-center mb-4">
          <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-inline-flex align-items-center justify-content-center fw-bold fs-2 mx-auto mb-3" style="width: 80px; height: 80px;">
            <%= targetUser.username ? targetUser.username.charAt(0).toUpperCase() : 'U' %>
          </div>
          <h4 class="fw-bold text-dark mb-1"><%= targetUser.username %></h4>
          
          <% if (targetUser.status === 'suspended') { %>
            <span class="badge bg-warning text-dark px-3 py-1 rounded-pill small fw-semibold">Suspended</span>
          <% } else if (targetUser.status === 'deactivated') { %>
            <span class="badge bg-secondary text-white px-3 py-1 rounded-pill small fw-semibold">Deactivated</span>
          <% } else { %>
            <span class="badge bg-success bg-opacity-10 text-success px-3 py-1 rounded-pill small fw-semibold">Active User</span>
          <% } %>
        </div>

        <div class="d-flex flex-column gap-3 border-top pt-3">
          <div>
            <small class="text-muted d-block text-uppercase fw-semibold" style="font-size: 0.7rem;">Email Address</small>
            <span class="text-dark fw-medium"><%= targetUser.email %></span>
          </div>
          <div>
            <small class="text-muted d-block text-uppercase fw-semibold" style="font-size: 0.7rem;">Contact Number</small>
            <span class="text-dark fw-medium"><%= targetUser.contact || 'Not Provided' %></span>
          </div>
          <div>
            <small class="text-muted d-block text-uppercase fw-semibold" style="font-size: 0.7rem;">Account ID</small>
            <span class="text-dark font-monospace small"><%= targetUser._id %></span>
          </div>
          <div>
            <small class="text-muted d-block text-uppercase fw-semibold" style="font-size: 0.7rem;">Total Listings Added</small>
            <span class="badge bg-dark text-white px-2.5 py-1 rounded-pill"><%= userListings.length %> Listings</span>
          </div>
        </div>

        <div class="mt-4 pt-2 border-top">
          <a href="/admin/chats/user/<%= targetUser._id %>" class="btn btn-dark w-100 rounded-3 fw-semibold shadow-sm">
            <i class="fa-solid fa-comments me-2"></i>View Official Chat / Notices
          </a>
        </div>
      </div>
    </div>

    <!-- User Listings Column -->
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
        <h5 class="fw-bold text-dark mb-3 pb-2 border-bottom d-flex align-items-center justify-content-between">
          <span>Listings Added by <%= targetUser.username %></span>
          <span class="badge bg-secondary bg-opacity-10 text-secondary fs-6 px-3 py-1"><%= userListings.length %></span>
        </h5>

        <% if (userListings && userListings.length > 0) { %>
          <div class="row g-3 overflow-auto" style="max-height: 60vh;">
            <% userListings.forEach(listing => { %>
              <div class="col-md-6">
                <div class="card border border-light shadow-sm rounded-4 overflow-hidden h-100 bg-light bg-opacity-25">
                  <% if (listing.image && listing.image.url) { %>
                    <img src="<%= listing.image.url %>" class="card-img-top" alt="listing image" style="height: 140px; object-fit: cover;">
                  <% } %>
                  <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                      <h6 class="fw-bold text-dark text-truncate mb-1"><%= listing.title %></h6>
                      <p class="text-muted small mb-2 text-truncate"><%= listing.location %>, <%= listing.country %></p>
                      <span class="text-danger fw-bold small">&#36;<%= listing.price ? listing.price.toLocaleString("en-US") : '0' %> / night</span>
                    </div>
                    <div class="mt-3 pt-2 border-top d-flex justify-content-between align-items-center">
                      <a href="/admin/listings/<%= listing._id %>" class="btn btn-sm btn-outline-dark rounded-3 px-3 fw-semibold">View Details</a>
                      <form action="/admin/listings/<%= listing._id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Delete this listing?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-3 px-2" title="Delete listing"><i class="fa-solid fa-trash-can"></i></button>
                      </form>
                    </div>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="text-center py-5 my-auto text-muted">
            <i class="fa-solid fa-house-chimney-slash fs-1 mb-2 d-block opacity-50"></i>
            <p class="mb-0">This user has not added any listings yet.</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>