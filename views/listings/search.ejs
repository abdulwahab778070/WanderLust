<% layout("/layouts/boilerplate.ejs") %>

<div class="container-fluid px-md-4 mt-4 mb-1">
  <!-- Mobile Filter Button (visible on screens < lg) -->
  <div class="d-lg-none mb-3">
    <button class="btn btn-outline-dark w-100 rounded-3 py-2 fw-semibold d-flex align-items-center justify-content-center gap-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#filterOffcanvas" aria-controls="filterOffcanvas">
      <i class="fa-solid fa-sliders text-danger"></i> Filters & Sorting Options
    </button>
  </div>

  <div class="row g-4">
    <!-- Filter & Sorting Sidebar (Desktop Grid & Mobile Offcanvas Drawer) -->
    <div class="col-12 col-lg-3">
      <div class="offcanvas-lg offcanvas-start bg-transparent" tabindex="-1" id="filterOffcanvas" aria-labelledby="filterOffcanvasLabel">
        <div class="offcanvas-header bg-white border-bottom d-lg-none">
          <h5 class="offcanvas-title fw-bold" id="filterOffcanvasLabel">
            <i class="fa-solid fa-sliders text-danger me-2"></i>Filters & Sorting
          </h5>
          <button type="button" class="btn-close shadow-none" data-bs-dismiss="offcanvas" data-bs-target="#filterOffcanvas" aria-label="Close"></button>
        </div>
        
        <div class="offcanvas-body p-0">
          <div class="card border-0 shadow-sm rounded-4 p-3 bg-white search-sidebar w-100">
            <h5 class="fw-bold mb-3 d-none d-lg-block">
              <i class="fa-solid fa-sliders text-danger me-2"></i>Filters
            </h5>
            
            <form action="/listings/search" method="GET">
              <!-- Search Keyword -->
              <div class="mb-3">
                <label for="q" class="form-label fw-semibold small">Keyword</label>
                <input type="text" id="q" name="q" class="form-control rounded-3" placeholder="Title, keyword..." value="<%= query.q || '' %>">
              </div>

              <!-- Category Dropdown -->
              <div class="mb-3">
                <label for="category" class="form-label fw-semibold small">Category</label>
                <select id="category" name="category" class="form-select rounded-3">
                  <option value="All" <%= !query.category || query.category === 'All' ? 'selected' : '' %>>All Categories</option>
                  <% const categories = ["Rooms", "Iconic Cities", "Mountains", "Castles", "Amazing Pools", "Camping", "Farms", "Arctic", "Domes", "Boats"]; %>
                  <% for(let cat of categories) { %>
                    <option value="<%= cat %>" <%= query.category === cat ? 'selected' : '' %>><%= cat %></option>
                  <% } %>
                </select>
              </div>

              <!-- Location / City -->
              <div class="mb-3">
                <label for="location" class="form-label fw-semibold small">City / Location</label>
                <input type="text" id="location" name="location" class="form-control rounded-3" placeholder="City..." value="<%= query.location || '' %>">
              </div>

              <!-- Country -->
              <div class="mb-3">
                <label for="country" class="form-label fw-semibold small">Country</label>
                <input type="text" id="country" name="country" class="form-control rounded-3" placeholder="Country..." value="<%= query.country || '' %>">
              </div>

              <!-- Price Range -->
              <div class="mb-3">
                <label class="form-label fw-semibold small">Price Range (PKR)</label>
                <div class="d-flex gap-2">
                  <input type="number" name="minPrice" class="form-control rounded-3" placeholder="Min" value="<%= query.minPrice || '' %>">
                  <input type="number" name="maxPrice" class="form-control rounded-3" placeholder="Max" value="<%= query.maxPrice || '' %>">
                </div>
              </div>

              <!-- Sort By -->
              <div class="mb-4">
                <label for="sort" class="form-label fw-semibold small">Sort By</label>
                <select id="sort" name="sort" class="form-select rounded-3">
                  <option value="date_desc" <%= !query.sort || query.sort === 'date_desc' ? 'selected' : '' %>>Newest First</option>
                  <option value="date_asc" <%= query.sort === 'date_asc' ? 'selected' : '' %>>Oldest First</option>
                  <option value="price_asc" <%= query.sort === 'price_asc' ? 'selected' : '' %>>Price: Low to High</option>
                  <option value="price_desc" <%= query.sort === 'price_desc' ? 'selected' : '' %>>Price: High to Low</option>
                </select>
              </div>

              <button class="btn btn-dark w-100 rounded-3 mb-2 py-2 fw-semibold">
                <i class="fa-solid fa-magnifying-glass me-1"></i>Apply Filters
              </button>
              <a href="/listings/search" class="btn btn-outline-secondary w-100 rounded-3 btn-sm">Reset All</a>
            </form>
          </div>
        </div>
      </div>
    </div>

    <!-- Vertical Listing Results -->
    <div class="col-12 col-lg-9">
      <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h4 class="fw-bold mb-0">
          Search Results 
          <% if(query.q) { %>
            <span class="text-muted fs-6 fw-normal">for "<%= query.q %>"</span>
          <% } %>
        </h4>
        <span class="badge bg-danger rounded-pill px-3 py-2 fs-6"><%= listings.length %> places found</span>
      </div>

      <% if(listings.length === 0) { %>
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white my-4">
          <i class="fa-solid fa-magnifying-glass fa-3x text-muted mb-3"></i>
          <h5 class="fw-bold">No places matched your search criteria</h5>
          <p class="text-muted small">Try adjusting your filters, location, or search terms.</p>
          <div>
            <a href="/listings/search" class="btn btn-dark rounded-3 btn-sm px-4">View All Listings</a>
          </div>
        </div>
      <% } %>

      <!-- Vertical Listing Cards Loop -->
      <div class="d-flex flex-column gap-4">
        <% for(let listing of listings) { %>
          <a href="/listings/<%= listing._id %>" class="text-decoration-none text-dark">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden vertical-listing-card">
              <div class="row g-0 align-items-center">
                
                <!-- Image Section -->
                <div class="col-12 col-md-4">
                  <div class="vertical-img-wrapper">
                    <img src="<%= listing.image.url %>" class="img-fluid vertical-card-img" alt="<%= listing.title %>">
                  </div>
                </div>

                <!-- Details Section -->
                <div class="col-12 col-md-8">
                  <div class="card-body p-3 p-md-4 d-flex flex-column justify-content-between h-100">
                    <div>
                      <div class="d-flex justify-content-between align-items-start mb-1">
                        <span class="badge bg-light text-danger border border-danger-subtle rounded-pill mb-2"><%= listing.category %></span>
                        <small class="text-muted"><i class="fa-solid fa-calendar-day me-1"></i><%= listing.date ? listing.date.toString().split(" ").slice(0, 4).join(" ") : '' %></small>
                      </div>

                      <h5 class="fw-bold mb-2"><%= listing.title %></h5>
                      <p class="text-muted small text-truncate-2 mb-3"><%= listing.description %></p>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                      <span class="text-secondary small">
                        <i class="fa-solid fa-location-dot me-1 text-danger"></i><%= listing.location %>, <%= listing.country %>
                      </span>
                      <h5 class="fw-bold text-danger mb-0">
                        &#8360 <%= listing.price.toLocaleString("en-PK") %> <span class="fs-6 text-muted fw-normal">/ night</span>
                      </h5>
                    </div>
                  </div>
                </div>

              </div>
            </div>
          </a>
        <% } %>
      </div>
    </div>
  </div>
</div>