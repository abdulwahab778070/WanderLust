<% layout("/layouts/boilerplate.ejs") %>

<link href="https://api.mapbox.com/mapbox-gl-js/v3.0.1/mapbox-gl.css" rel="stylesheet" />
<script src="https://api.mapbox.com/mapbox-gl-js/v3.0.1/mapbox-gl.js"></script>

<script id="listing-data" type="application/json">
  <%- JSON.stringify(listing) %>
</script>

<script>
    const mapToken = "<%= mapToken %>";
    const listing = JSON.parse(document.getElementById("listing-data").textContent);
</script>

<div class="row mt-3 mb-5 pb-5">
  <!-- Listing Details Header -->
  <div class="col-12 col-md-8 offset-md-2 mb-3">
    <h2 class="fw-bold"><%= listing.title %></h2>
    <p class="text-muted"><i class="fa-solid fa-location-dot me-1 text-danger"></i><%= listing.location %>, <%= listing.country %></p>
  </div>

  <!-- Image Card -->
  <div class="col-12 col-md-8 offset-md-2 mb-4">
    <img src="<%= listing.image.url %>" class="show-image w-100" alt="listing_image">
  </div>

  <!-- Info Card -->
  <div class="col-12 col-md-8 offset-md-2">
    <div class="card border-0 shadow-sm p-3 p-md-4 rounded-4 mb-4">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div class="d-flex align-items-center">
          <div class="bg-light rounded-circle p-3 me-3">
            <i class="fa-solid fa-user-circle fa-2x text-secondary"></i>
          </div>
          <div>
            <h6 class="mb-0 fw-bold">Hosted by <%= listing.owner.username %></h6>
            <small class="text-muted">Listed on <%= listing.date ? listing.date.toString().split(" ").slice(0, 4).join(" ") : 'N/A' %></small>
          </div>
        </div>
      </div>

      <hr>

      <p class="fs-5"><%= listing.description %></p>
      <h4 class="fw-bold text-danger mt-3">&#8360 <%= listing.price.toLocaleString("en-PK") %> <span class="fs-6 text-muted fw-normal">/ night</span></h4>
    </div>

    <!-- Map Section -->
    <div class="mb-5">
      <h4 class="fw-bold mb-3">Where you'll be</h4>
      <div id="map" style="height: 400px; width: 100%; border-radius: 1rem;"></div>
    </div>

    <hr class="my-4">

    <!-- Leave Review Section -->
    <div class="mb-5">
      <h4 class="fw-bold mb-3">Leave a Review</h4>
      <form method="post" action="/listings/<%= listing._id %>/reviews" novalidate class="needs-validation">
        <div class="mb-3">
          <label class="form-label fw-semibold">Rating</label>
          <div class="star-rating">
            <input type="radio" id="rate5" name="review[rating]" value="5" required />
            <label for="rate5" title="5 stars"><i class="fa-solid fa-star"></i></label>
            <input type="radio" id="rate4" name="review[rating]" value="4" />
            <label for="rate4" title="4 stars"><i class="fa-solid fa-star"></i></label>
            <input type="radio" id="rate3" name="review[rating]" value="3" />
            <label for="rate3" title="3 stars"><i class="fa-solid fa-star"></i></label>
            <input type="radio" id="rate2" name="review[rating]" value="2" />
            <label for="rate2" title="2 stars"><i class="fa-solid fa-star"></i></label>
            <input type="radio" id="rate1" name="review[rating]" value="1" />
            <label for="rate1" title="1 star"><i class="fa-solid fa-star"></i></label>
          </div>
          <div class="invalid-feedback">Please select a rating.</div>
        </div>

        <div class="mb-3">
          <label for="comment" class="form-label fw-semibold">Comments</label>
          <textarea id="comment" name="review[comment]" rows="4" placeholder="Share details of your experience..." class="form-control rounded-3" required></textarea>
          <div class="invalid-feedback">Please enter a short review comment.</div>
        </div>

        <button class="btn btn-dark">Submit Review</button>
      </form>
    </div>

    <!-- Display Reviews Grid -->
    <% if(listing.reviews && listing.reviews.length > 0) { %>
      <div class="mb-5">
        <h4 class="fw-bold mb-3">All Reviews</h4>
        <div class="row row-cols-1 row-cols-md-2 g-3">
          <% for(let review of listing.reviews) { %>
            <div class="col">
              <div class="card h-100 border-0 shadow-sm p-3 rounded-4">
                <div class="card-body d-flex flex-column justify-content-between">
                  <div>
                    <h6 class="fw-bold mb-1"><%= review.author.username %></h6>
                    <div class="mb-2">
                      <% for(let i = 1; i <= 5; i++) { %>
                        <i class="fa-solid fa-star <%= i <= review.rating ? 'text-warning' : 'text-secondary opacity-25' %>"></i>
                      <% } %>
                    </div>
                    <p class="card-text text-secondary mb-3"><%= review.comment %></p>
                  </div>

                  <% if(crrUser && crrUser._id.equals(review.author._id)) { %>
                    <form method="post" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                      <button class="btn btn-sm btn-outline-danger border-0"><i class="fa-solid fa-trash me-1"></i>Delete</button>
                    </form>
                  <% } %>
                </div>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    <% } %>

  </div>
</div>

<!-- Sticky Bottom Action Bar -->
<div class="sticky-contact-bar fixed-bottom bg-white border-top shadow-lg py-3 px-3 px-md-5">
  <div class="container-fluid d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
      <h5 class="fw-bold text-danger mb-0">&#8360 <%= listing.price.toLocaleString("en-PK") %> <span class="fs-6 text-muted fw-normal">/ night</span></h5>
      <small class="text-muted d-none d-sm-inline"><i class="fa-solid fa-shield-halved text-success me-1"></i> Verified Listing</small>
    </div>

    <div class="d-flex align-items-center gap-2 flex-wrap">
      <% if(crrUser && crrUser._id.equals(listing.owner._id)) { %>
        <!-- Owner Controls inside Bottom Bar -->
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark rounded-pill px-3 fw-semibold">
          <i class="fa-solid fa-pen-to-square me-1"></i> Edit Listing
        </a>
        <form method="post" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this listing?');">
          <button class="btn btn-outline-danger rounded-pill px-3 fw-semibold">
            <i class="fa-solid fa-trash me-1"></i> Delete Listing
          </button>
        </form>
      <% } else { %>
        <!-- Regular Visitor / Buyer Controls -->
        <% if(listing.owner.contact) { %>
          <button id="reveal-contact-btn" class="btn btn-outline-dark rounded-pill px-3 fw-semibold" onclick="toggleContactNumber('<%= listing.owner.contact %>')">
            <i class="fa-solid fa-phone me-1 text-danger"></i> Click Contact Number
          </button>
        <% } %>

        <% if(crrUser) { %>
          <a href="/listings/<%= listing._id %>/direct-message" class="btn btn-danger rounded-pill px-3 fw-semibold">
            <i class="fa-solid fa-paper-plane me-1"></i> Direct Message
          </a>
        <% } else { %>
          <a href="/login" class="btn btn-danger rounded-pill px-3 fw-semibold">
            <i class="fa-solid fa-paper-plane me-1"></i> Direct Message
          </a>
        <% } %>
      <% } %>
    </div>
  </div>
</div>

<script>
  function toggleContactNumber(number) {
    const btn = document.getElementById("reveal-contact-btn");
    if (btn.getAttribute("data-revealed") !== "true") {
      btn.innerHTML = `<i class="fa-solid fa-phone me-1 text-success"></i> ${number}`;
      btn.classList.remove("btn-outline-dark");
      btn.classList.add("btn-dark");
      btn.setAttribute("data-revealed", "true");
    } else {
      window.location.href = `tel:${number}`;
    }
  }
</script>

<script src="/js/map.js"></script>