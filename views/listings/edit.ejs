<% layout("/layouts/boilerplate.ejs") %>

<div class="row mt-3">
  <div class="col-12 col-md-8 col-lg-6 offset-md-2 offset-lg-3">
    <div class="card border-0 shadow-sm p-4 rounded-4 bg-white">
      <h3 class="fw-bold mb-4">Edit Listing</h3>

      <form method="post" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="mb-3">
          <label for="title" class="form-label fw-semibold">Title</label>
          <input id="title" name="listing[title]" value="<%= listing.title %>" type="text" class="form-control rounded-3" required>
          <div class="invalid-feedback">Please enter a title.</div>
        </div>

        <div class="mb-3">
          <label for="category" class="form-label fw-semibold">Category</label>
          <select id="category" name="listing[category]" class="form-select rounded-3" required>
            <% const categories = ["Rooms", "Iconic Cities", "Mountains", "Castles", "Amazing Pools", "Camping", "Farms", "Arctic", "Domes", "Boats"]; %>
            <% for(let cat of categories) { %>
              <option value="<%= cat %>" <%= listing.category === cat ? 'selected' : '' %>><%= cat %></option>
            <% } %>
          </select>
          <div class="invalid-feedback">Please select a category.</div>
        </div>

        <div class="mb-3">
          <label for="description" class="form-label fw-semibold">Description</label>
          <textarea id="description" name="listing[description]" rows="4" class="form-control rounded-3" required><%= listing.description %></textarea>
          <div class="invalid-feedback">Please enter a description.</div>
        </div>

        <div class="mb-3">
          <label class="form-label fw-semibold d-block">Current Image Preview</label>
          <img src="<%= orignalImageUrl %>" class="rounded-3 shadow-sm mb-2" style="height: 10rem; object-fit: cover; width: 100%;">
        </div>

        <div class="mb-3">
          <label for="image" class="form-label fw-semibold">Upload New Image (Optional)</label>
          <input id="image" name="listing[image]" type="file" class="form-control rounded-3">
        </div>

        <div class="row">
          <div class="mb-3 col-md-5">
            <label for="price" class="form-label fw-semibold">Price per Night (PKR)</label>
            <input id="price" name="listing[price]" value="<%= listing.price %>" type="number" class="form-control rounded-3" required>
            <div class="invalid-feedback">Price should be valid.</div>
          </div>

          <div class="mb-3 col-md-7">
            <label for="country" class="form-label fw-semibold">Country</label>
            <input id="country" name="listing[country]" value="<%= listing.country %>" type="text" class="form-control rounded-3" required>
            <div class="invalid-feedback">Country name is required.</div>
          </div>
        </div>

        <div class="mb-4">
          <label for="location" class="form-label fw-semibold">Location</label>
          <input id="location" name="listing[location]" value="<%= listing.location %>" type="text" class="form-control rounded-3" required>
          <div class="invalid-feedback">Location should be valid.</div>
        </div>

        <button class="btn btn-dark w-100 py-2">Save Changes</button>
      </form>
    </div>
  </div>
</div>