<% layout("/layouts/boilerplate.ejs") %>

<div class="row mt-3">
  <div class="col-12 col-md-8 col-lg-6 offset-md-2 offset-lg-3">
    <div class="card border-0 shadow-sm p-4 rounded-4 bg-white">
      <h3 class="fw-bold mb-4">Create New Listing</h3>
      
      <form method="post" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="mb-3">
          <label for="title" class="form-label fw-semibold">Title</label>
          <input id="title" name="listing[title]" placeholder="Catchy title for your place" type="text" class="form-control rounded-3" required>
          <div class="invalid-feedback">Please provide a valid title.</div>
        </div>

        <div class="mb-3">
          <label for="category" class="form-label fw-semibold">Category</label>
          <select id="category" name="listing[category]" class="form-select rounded-3" required>
            <option value="" disabled selected>Select Category</option>
            <option value="Rooms">Rooms</option>
            <option value="Iconic Cities">Iconic Cities</option>
            <option value="Mountains">Mountains</option>
            <option value="Castles">Castles</option>
            <option value="Amazing Pools">Amazing Pools</option>
            <option value="Camping">Camping</option>
            <option value="Farms">Farms</option>
            <option value="Arctic">Arctic</option>
            <option value="Domes">Domes</option>
            <option value="Boats">Boats</option>
          </select>
          <div class="invalid-feedback">Please select a category.</div>
        </div>

        <div class="mb-3">
          <label for="description" class="form-label fw-semibold">Description</label>
          <textarea id="description" name="listing[description]" rows="4" placeholder="Describe the ambiance, features, and surroundings" class="form-control rounded-3" required></textarea>
          <div class="invalid-feedback">Please enter a short description.</div>
        </div>

        <div class="mb-3">
          <label for="image" class="form-label fw-semibold">Upload Property Image</label>
          <input id="image" name="listing[image]" type="file" class="form-control rounded-3" required>
          <div class="invalid-feedback">Please upload an image file.</div>
        </div>

        <div class="row">
          <div class="mb-3 col-md-5">
            <label for="price" class="form-label fw-semibold">Price per Night (PKR)</label>
            <input id="price" name="listing[price]" placeholder="15000" type="number" class="form-control rounded-3" required>
            <div class="invalid-feedback">Please enter a valid price.</div>
          </div>

          <div class="mb-3 col-md-7">
            <label for="country" class="form-label fw-semibold">Country</label>
            <input id="country" name="listing[country]" placeholder="enter country" type="text" class="form-control rounded-3" required>
            <div class="invalid-feedback">Country name is required.</div>
          </div>
        </div>

        <div class="mb-4">
          <label for="location" class="form-label fw-semibold">Location / City</label>
          <input id="location" name="listing[location]" placeholder="enter full address..." type="text" class="form-control rounded-3" required>
          <div class="invalid-feedback">Location is required.</div>
        </div>

        <button class="btn btn-dark w-100 py-2">Create Listing</button>
      </form>
    </div>
  </div>
</div>